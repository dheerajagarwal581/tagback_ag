# ==============================================================================
# ENVIRONMENT CONFIGURATION EXAMPLE
# QR-Based Temporary Communication & Lost-and-Found Platform
# ==============================================================================

# Application Environment (development, test, production)
APP_ENV=development
DEBUG=True

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
BACKEND_URL=http://localhost:8000

# Frontend Configuration
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database Configuration
# Local Development: Uses zero-setup SQLite file (qr_dev.db)
# Production / Render: Automatically overridden by Render's managed PostgreSQL
DATABASE_URL=sqlite+aiosqlite:///./qr_dev.db
DB_ECHO=False

# Security & Cryptography
# Generate a secure 32+ byte key for production: openssl rand -hex 32
SECRET_KEY=change_me_to_a_very_secure_random_string_in_production
SESSION_COOKIE_NAME=qr_owner_session
GUEST_COOKIE_NAME=qr_guest_session
SESSION_MAX_AGE_SECONDS=604800
SECURE_COOKIES=False
SAME_SITE=lax

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# File Upload Configuration (Local / Phase 2)
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_BYTES=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# Rate Limiting
RATE_LIMIT_CONTACT_PER_MINUTE=5
RATE_LIMIT_MESSAGES_PER_MINUTE=30

# Notifications (Phase 2 - Optional)
# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=secret_smtp_password
EMAIL_FROM=no-reply@example.com

# Web Push (VAPID)
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_CLAIM_EMAIL=mailto:admin@example.com
